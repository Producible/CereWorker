{
  "name": "cereworker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "start": "pnpm --filter @cereworker/cli start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --exclude 'apps/cli/src/service.integration.test.ts' --exclude 'apps/cli/src/cli.smoke.test.ts'",
    "test:e2e:integration": "vitest run apps/cli/src/service.integration.test.ts",
    "test:e2e:cli": "pnpm build && vitest run apps/cli/src/cli.smoke.test.ts",
    "test:e2e:install": "bash scripts/e2e/install-smoke.sh"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.18.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "version": "26.329.23"
}
