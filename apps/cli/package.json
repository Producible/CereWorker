{
  "name": "@producible/cereworker",
  "version": "26.520.2",
  "type": "module",
  "bin": {
    "cereworker": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Producible/CereWorker.git",
    "directory": "apps/cli"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "prebuild": "rm -rf skills && cp -r ../../skills skills",
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "generate:logo": "tsx scripts/generate-logo.ts"
  },
  "dependencies": {
    "@producible/cereworker-core": "workspace:*",
    "@producible/cereworker-config": "workspace:*",
    "@producible/cereworker-cerebrum": "workspace:*",
    "@producible/cereworker-cerebellum-client": "workspace:*",
    "@producible/cereworker-skills": "workspace:*",
    "@producible/cereworker-channels": "workspace:*",
    "@producible/cereworker-browser": "workspace:*",
    "@producible/cereworker-hippocampus": "workspace:*",
    "@producible/cereworker-gateway": "workspace:*",
    "@clack/prompts": "^0.9.1",
    "ink": "^5.1.0",
    "@inkjs/ui": "^2.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "sharp": "^0.33.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3"
  }
}
